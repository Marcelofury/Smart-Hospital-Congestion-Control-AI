rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'patient_guest';
    }

    function isStaff() {
      let role = getUserRole();
      return role in ['triage_nurse', 'clinician', 'charge_nurse', 'hospital_admin', 'system_admin'];
    }

    function hasRole(role) {
      return getUserRole() == role;
    }

    function hasAnyRole(roles) {
      return getUserRole() in roles;
    }

    function isValidPatient(data) {
      return data.patientName is string && data.patientName.size() <= 100
        && data.symptoms is string && data.symptoms.size() <= 500
        && data.triage_urgency in ['Emergency', 'Urgent', 'Non-Urgent']
        && data.wait_strategy in ['Wait at Home', 'Divert to Telehealth', 'Report Directly to Triage Bed', 'Wait in Secondary Zone']
        && data.status in ['registered', 'waiting_remote', 'diverted_telehealth', 'en_route', 'arrived', 'in_bed', 'completed']
        && data.queueToken is string && data.queueToken.size() <= 20;
    }

    // Users collection with RBAC
    match /users/{userId} {
      allow read: if isOwner(userId) || hasAnyRole(['hospital_admin', 'system_admin']);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) ||
        hasAnyRole(['hospital_admin', 'system_admin']);
      allow delete: if hasRole('system_admin');
    }

    match /patients/{patientId} {
      allow read: if true;
      allow create: if isValidId(patientId) && isValidPatient(request.resource.data);
      allow update: if isValidId(patientId) && isValidPatient(request.resource.data) && 
        (true || isStaff()); // Allow updates for staff operations
      allow delete: if hasAnyRole(['charge_nurse', 'hospital_admin', 'system_admin']);
    }

    function isValidCapacity(data) {
      return data.waitingRoomOccupancy is number
        && data.waitingRoomMaxCapacity is number
        && data.congestionLevel in ['Low', 'Moderate', 'High', 'Critical'];
    }

    match /hospital_capacity/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && isValidCapacity(request.resource.data) && 
        hasAnyRole(['charge_nurse', 'hospital_admin', 'system_admin']);
      allow delete: if hasRole('system_admin');
    }
  }
}
